# Configuração da URL base do encurtador
# Exemplo para desenvolvimento local:
# URL_BASE=http://localhost:8000/
# Exemplo para produção:
# URL_BASE=https://seudominio.com/

URL_BASE=http://localhost:8000/

# Configuração de CORS (origens permitidas)
# Separe múltiplas origens por vírgula (sem espaços)
# Exemplo para desenvolvimento local:
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# Exemplo para produção:
# CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ===================================
# Configurações de Autenticação JWT
# ===================================

# Chave secreta para assinatura dos tokens JWT
# OBRIGATÓRIO em produção! Gere uma chave segura com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA commite sua chave secreta no repositório!
SECRET_KEY=

# Algoritmo de assinatura JWT (padrão: HS256)
# Opções comuns: HS256, HS384, HS512
ALGORITHM=HS256

# Tempo de expiração do token de acesso em minutos (padrão: 30)
# Valores menores são mais seguros, mas requerem login mais frequente
ACCESS_TOKEN_EXPIRE_MINUTES=30
